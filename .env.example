# Courtnotes configuration. Copy to .env and fill in.
# Every variable is read at startup, so one build or Docker image serves any program.

# --- Database ---------------------------------------------------------------------------------
# Postgres connection string. Leave unset to use the embedded PGlite database in ./.data
# (handy for trying Courtnotes out; use Postgres for a real program).
# DATABASE_URL=postgres://courtnotes:courtnotes@localhost:5432/courtnotes

# --- Your program -----------------------------------------------------------------------------
# Stable, URL-safe id stamped on every record (lowercase letters, digits, dashes).
PROGRAM_ID=example-court-watch
PROGRAM_NAME=Example County Court Watch
# ISO 3166-2 code of your state or province, added to records that don't specify one.
PROGRAM_JURISDICTION=US-PA
# IANA time zone used to group hearings by day on the dashboard and in reports.
PROGRAM_TIMEZONE=America/New_York

# --- Access -------------------------------------------------------------------------------------
# Shared code volunteers type into the app on their phone. Sync is off until this is set.
# Change it to cut off a lost phone or a departed volunteer.
WATCHER_ACCESS_CODE=change-me-to-something-long

# First coordinator account, created on startup if no coordinators exist yet.
# Add more later with: npm run coordinator:create -- --email someone@example.org
COORDINATOR_EMAIL=coordinator@example.org
COORDINATOR_PASSWORD=change-me-please
COORDINATOR_NAME=Coordinator

# --- Server (adapter-node) ----------------------------------------------------------------------
# The public URL people use. Required behind a proxy so sign-in forms pass CSRF checks.
ORIGIN=http://localhost:3000
PORT=3000
# Volunteers can upload a few hundred records at once after a day offline.
BODY_SIZE_LIMIT=6M
# Behind a reverse proxy that terminates TLS, also set:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
# POSTGRES_PASSWORD is only used by docker-compose.yml.
