{
	"name": "courtnotes",
	"version": "1.0.0",
	"description": "Offline-first data collection for court watch programs: a silent, dark, big-button PWA for volunteers, a live dashboard for coordinators, and an open data standard for comparing courts across cities.",
	"license": "AGPL-3.0-or-later",
	"author": "Joel Stain Lobo",
	"homepage": "https://github.com/lobojoel2003/Courtnotes#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lobojoel2003/Courtnotes.git"
	},
	"bugs": {
		"url": "https://github.com/lobojoel2003/Courtnotes/issues"
	},
	"keywords": [
		"court-watch",
		"courtwatch",
		"bail",
		"criminal-justice",
		"civic-tech",
		"pwa",
		"offline-first",
		"sveltekit",
		"open-data",
		"json-schema"
	],
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:migrate": "node scripts/migrate.ts",
		"db:seed": "node scripts/seed.ts",
		"coordinator:create": "node scripts/create-coordinator.ts",
		"icons": "node scripts/generate-icons.ts",
		"screenshots": "node scripts/screenshots.ts"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.17",
		"@observablehq/plot": "^0.6.19",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"idb": "^8.0.4",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22",
		"@types/pg": "^8.23.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
